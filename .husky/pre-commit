echo "🔍 Iniciando auditoria estática de governança (Exposed-Fix)..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$')

if [ -z "$STAGED_FILES" ]; then
    echo "✅ Nenhum arquivo TypeScript modificado. Pulando validação."
    exit 0
fi

ERRORS_FOUND=0

for FILE in $STAGED_FILES; do
    if [ ! -f "$FILE" ]; then
        continue
    fi

    if git diff --cached "$FILE" | grep -qE '\.([a-zA-Z0-9_]+)\.(put|add|update|delete|bulkPut|bulkAdd)\('; then
        if ! grep -q "transaction(" "$FILE"; then
            echo "❌ ERRO em [$FILE]: Detectada escrita Dexie sem bloco de transação explícito ('db.transaction')."
            ERRORS_FOUND=$((ERRORS_FOUND + 1))
        fi
    fi

    if git diff --cached "$FILE" | grep -qE '(addEventListener|\.subscribe\()'; then
        if ! grep -qE '(removeEventListener|unsubscribe|return\s*\(\s*\)\s*=>)' "$FILE"; then
            echo "❌ ERRO em [$FILE]: Detectado listener ou subscrição ativa sem estrutura de cleanup evidente."
            ERRORS_FOUND=$((ERRORS_FOUND + 1))
        fi
    fi
done

if [ "$ERRORS_FOUND" -gt 0 ]; then
    echo "🚫 Commit bloqueado! Corrija os padrões de arquitetura apontados acima."
    exit 1
fi

echo "✅ Auditoria de padrões concluída com sucesso!"
# ... (código anterior da validação por regex)

echo "📦 Validando tipos TypeScript apenas dos arquivos modificados..."
if [ -n "$STAGED_FILES" ]; then
    npx tsc-files --noEmit $STAGED_FILES
else
    echo "✅ Nenhum arquivo TypeScript para checar tipos."
fi

# Se o tsc-files falhar, o Husky vai bloquear o commit apenas se o erro for nos seus arquivos staged.
